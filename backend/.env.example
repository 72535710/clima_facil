# Configuración de Servidor y Base de Datos SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=ClimaFacilDB
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes
# Si se usa autenticación SQL (opcional, en caso de no usar autenticación de Windows)
# DB_USER=
# DB_PASSWORD=

# Coordenadas geográficas de referencia (Huancayo, Junín, Perú)
HUANCAYO_LATITUDE=-12.0651
HUANCAYO_LONGITUDE=-75.2049

# Configuración de la API y CORS
API_PORT=8000
CORS_ORIGIN=http://localhost:4200
